# ============================================================
# VERITAS 3.0 — Evidence-Aware Decision Intelligence System
# Configuration & Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# ---- Chat Authentication & Persistence ----
# JWT secret key (generate a strong random string for production)
SECRET_KEY=
# Token expiry in minutes (default: 10080 = 7 days)
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# SQLAlchemy database URL (default: SQLite in backend/data/veritas.db)
# DATABASE_URL=sqlite:///./backend/data/veritas.db

# ---- Primary Reasoning Engine: Groq ----
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ---- Fallback Reasoning Engine: Google Gemini ----
# Activated only on Groq failure
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Optional: Google Generative AI Embeddings (if set, used for new FAISS index builds)
# GOOGLE_API_KEY=

# ---- Local MedlinePlus XML Ingestion ----
MEDLINEPLUS_XML_PATH=data/medlineplus/raw/mplus_topics.xml

# ---- Authoritative Source Endpoints ----
WHO_API_BASE_URL=https://ghoapi.azureedge.net/api
FDA_API_KEY=
FDA_API_BASE_URL=https://api.fda.gov

# ---- Vector Index & Persistence ----
CHROMA_PERSIST_DIRECTORY=data/medlineplus/index
CACHE_EXPIRY_HOURS=72

# ---- Application Settings ----
DEBUG=False
PORT=8000
HOST=0.0.0.0
